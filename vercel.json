{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/assets/app\\.css",
      "dest": "/assets/app.css"
    },
    {
      "src": "/assets/app\\.js",
      "dest": "/assets/app.js"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
